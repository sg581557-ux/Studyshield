{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/index.css",
    "src/lib/supabase.ts",
    "src/lib/utils.ts",
    "src/lib/types.ts",
    "src/lib/constants.ts",
    "src/lib/cn.ts",
    "src/services/db.ts",
    "src/services/planner.ts",
    "src/context/AuthContext.tsx",
    "src/context/ToastContext.tsx",
    "src/components/ErrorBoundary.tsx",
    "src/components/States.tsx",
    "src/components/ui.tsx",
    "src/components/Guards.tsx",
    "src/components/Form.tsx",
    "src/components/ui/Input.tsx",
    "src/pages/Login.tsx",
    "src/pages/Signup.tsx",
    "src/pages/ForgotPassword.tsx",
    "src/pages/ResetPassword.tsx",
    "src/pages/Onboarding.tsx",
    "src/pages/dashboard/Layout.tsx",
    "src/pages/dashboard/DashboardHome.tsx",
    "src/pages/dashboard/AIPlanner.tsx",
    "src/pages/dashboard/BacklogPlanner.tsx",
    "src/pages/dashboard/RecoveryBucket.tsx",
    "src/pages/dashboard/SubjectManager.tsx",
    "src/pages/dashboard/FormulaVault.tsx",
    "src/pages/dashboard/FocusTimer.tsx",
    "src/pages/dashboard/Analytics.tsx",
    "src/pages/dashboard/Settings.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
